{
  "name": "habits-workspace",
  "private": true,
  "version": "2.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "setup/aulas/server",
    "setup/aulas/web"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs && npm run db:generate && npm run db:migrate",
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm run dev -w @habits/server\" \"npm run dev -w @habits/web\"",
    "db:generate": "npm run db:generate -w @habits/server",
    "db:migrate": "npm run db:migrate -w @habits/server",
    "db:seed": "npm run db:seed -w @habits/server",
    "build": "npm run build --workspaces",
    "test": "npm run test -w @habits/server",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build",
    "start": "npm run start -w @habits/server",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:pages": "npm run build:pages -w @habits/web",
    "preview:pages": "npm run preview:pages -w @habits/web",
    "test:pages": "playwright test -c playwright.pages.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10"
  }
}
